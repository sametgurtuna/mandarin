<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark colour tokens. Same keys as Tokens.Light.xaml — see the note there.

        The neutrals stay warm (brown-grey, not blue-grey) so the mandarin accent
        still belongs, and the accent itself is unchanged: it already passes on
        both surfaces.
    -->

    <Color x:Key="AccentColor">#EB5E14</Color>
    <Color x:Key="AccentLightColor">#FFA834</Color>
    <Color x:Key="AccentDarkColor">#C64A0C</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="#EB5E14" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#FFA834" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#FF7A2E" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3A2517" />
    <SolidColorBrush x:Key="LeafBrush" Color="#5DBE61" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="#2A2724" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#232120" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#1B1918" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#37322E" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#453F3A" />
    <SolidColorBrush x:Key="BorderBrushToken" Color="#3A3430" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#544C46" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F6F2EE" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C6BEB6" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#968D85" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="ViewportBrush" Color="#141315" />
    <SolidColorBrush x:Key="ViewportAltBrush" Color="#232125" />

    <SolidColorBrush x:Key="DangerTextBrush" Color="#F19A9A" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#33201E" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#6B3E3A" />

    <SolidColorBrush x:Key="AcrylicTintBrush" Color="#B2232120" />
    <SolidColorBrush x:Key="AcrylicSunkenBrush" Color="#8C1B1918" />
    <SolidColorBrush x:Key="AcrylicDarkTintBrush" Color="#BF1B1918" />

    <SolidColorBrush x:Key="WheelDiscInnerBrush" Color="#D62E2B28" />
    <SolidColorBrush x:Key="WheelDiscOuterBrush" Color="#C41F1D1B" />
    <SolidColorBrush x:Key="WheelCentreBrush" Color="#F2302C29" />
    <SolidColorBrush x:Key="WheelPetalBrush" Color="#D63A3532" />
    <SolidColorBrush x:Key="WheelPetalStrokeBrush" Color="#AA544C46" />
    <SolidColorBrush x:Key="WheelBarBrush" Color="#D92A2724" />

</ResourceDictionary>
