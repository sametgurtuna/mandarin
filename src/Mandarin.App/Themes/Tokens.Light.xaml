<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light colour tokens.

        This dictionary and Tokens.Dark.xaml define exactly the same keys; the
        app swaps one for the other at runtime (see Themes/ThemeManager.cs), so
        anything that must follow the theme has to reference these keys with
        DynamicResource, not StaticResource. Keys that never change with the
        theme (metrics, fonts, the accent) live in Theme.xaml.
    -->

    <Color x:Key="AccentColor">#EB5E14</Color>
    <Color x:Key="AccentLightColor">#FFA834</Color>
    <Color x:Key="AccentDarkColor">#C64A0C</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="#EB5E14" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#FFA834" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#C64A0C" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFF1E4" />
    <SolidColorBrush x:Key="LeafBrush" Color="#4CAF50" />

    <!-- Warm neutrals: the app sits on a slightly warm grey, not blue-grey. -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FDFCFB" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#F5F3F1" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EFEBE7" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E3DDD7" />
    <SolidColorBrush x:Key="BorderBrushToken" Color="#E7E2DC" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CFC7BE" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C1917" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#57534E" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8C8379" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Media viewports stay near-black in both themes so images read correctly. -->
    <SolidColorBrush x:Key="ViewportBrush" Color="#17161A" />
    <SolidColorBrush x:Key="ViewportAltBrush" Color="#2A272C" />

    <SolidColorBrush x:Key="DangerTextBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDF2F2" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#F3C6C6" />

    <!-- Veils over the Windows 11 acrylic backdrop; the alpha is what lets the
         blurred desktop through. -->
    <SolidColorBrush x:Key="AcrylicTintBrush" Color="#B5FDFCFB" />
    <SolidColorBrush x:Key="AcrylicSunkenBrush" Color="#8CEFEBE7" />
    <SolidColorBrush x:Key="AcrylicDarkTintBrush" Color="#B2211D1A" />

    <!-- The radial wheel paints its own glass (it is circular, so it cannot have
         a real backdrop) — these are the only translucent fills it needs. -->
    <SolidColorBrush x:Key="WheelDiscInnerBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="WheelDiscOuterBrush" Color="#B8F2EDE7" />
    <SolidColorBrush x:Key="WheelCentreBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="WheelPetalBrush" Color="#D6FFFFFF" />
    <SolidColorBrush x:Key="WheelPetalStrokeBrush" Color="#AAE7E2DC" />
    <SolidColorBrush x:Key="WheelBarBrush" Color="#D9FFFFFF" />

</ResourceDictionary>
