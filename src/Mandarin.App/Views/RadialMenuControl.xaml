<UserControl x:Class="Mandarin.App.Views.RadialMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Mandarin.App.Resources"
             Width="360" Height="360"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             IsHitTestVisible="True"
             Background="Transparent">

    <UserControl.Resources>
        <Style TargetType="{x:Type Control}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </UserControl.Resources>

    <Grid Width="360" Height="360" IsHitTestVisible="True" Focusable="False" FocusVisualStyle="{x:Null}">
        <!-- Floating frosted disc.

             This window is circular, so it stays layered (per-pixel alpha) and
             the glass is painted rather than blurred: Windows can only put a
             real acrylic backdrop behind a rectangular, non-layered window, and
             a layered window ignores SetWindowRgn, so a blur cannot be clipped
             to the circle. The dialogs, which are rectangular, get the real
             thing — see Themes/WindowBackdrop.cs. -->
        <Ellipse Width="292" Height="292" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"
                 Fill="{DynamicResource WheelDiscOuterBrush}"
                 Stroke="{DynamicResource WheelPetalStrokeBrush}"
                 StrokeThickness="1">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#2B2018" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- Petals Drawing Canvas (Centered at 180, 180) -->
        <Canvas x:Name="PetalsCanvas" Width="0" Height="0"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False" />

        <!-- Center Action Disc & Label -->
        <Grid Width="94" Height="94" HorizontalAlignment="Center" VerticalAlignment="Center"
              IsHitTestVisible="False">
            <Ellipse Width="94" Height="94" IsHitTestVisible="False"
                     Fill="{DynamicResource WheelCentreBrush}"
                     Stroke="{DynamicResource BorderBrushToken}"
                     StrokeThickness="1.2">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1.5" Opacity="0.12" Color="#2B2018" />
                </Ellipse.Effect>
            </Ellipse>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6"
                        IsHitTestVisible="False">
                <TextBlock x:Name="CenterMainText" Text="{x:Static res:Strings.RadialCenterTitle}"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="82"
                           IsHitTestVisible="False" />
                <TextBlock x:Name="CenterSubText" Text="{x:Static res:Strings.RadialCenterHint}"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="82" Margin="0,2,0,0"
                           IsHitTestVisible="False" />
            </StackPanel>
        </Grid>

        <!-- Key Modifiers Prompt Bar (Top) -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                Background="{DynamicResource WheelBarBrush}" CornerRadius="12" Padding="7,3"
                BorderBrush="{DynamicResource BorderBrushToken}" BorderThickness="1"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1.5" Opacity="0.10" Color="#2B2018" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                <Border x:Name="ShiftKeyBadge" Background="{DynamicResource AccentBrush}" CornerRadius="5" Padding="6,1.5" Margin="0,0,6,0" IsHitTestVisible="False">
                    <TextBlock Text="{x:Static res:Strings.RadialShiftBadge}" FontSize="10" FontWeight="Bold" Foreground="White" IsHitTestVisible="False" />
                </Border>
                <TextBlock x:Name="ModeHintText" Text="{x:Static res:Strings.RadialModeConvert}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False" />
                <TextBlock Text="·" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False" />
                <Border x:Name="AltKeyBadge" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="5" Padding="6,1.5" Margin="0,0,6,0" IsHitTestVisible="False">
                    <TextBlock x:Name="AltKeyBadgeText" Text="{x:Static res:Strings.RadialAltBadge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False">
                    </TextBlock>
                </Border>
                <TextBlock Text="{x:Static res:Strings.RadialModeTools}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
