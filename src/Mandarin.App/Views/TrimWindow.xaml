<Window x:Class="Mandarin.App.Views.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Mandarin.App.Resources"
        Title="{x:Static res:Strings.TrimTitle}"
        Width="496" Height="636"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        ShowInTaskbar="False">
    <!-- No OS title bar, but a real (non-layered) window: the DWM acrylic
         backdrop needs a glass frame extended over the whole client area, which
         a per-pixel-alpha window cannot have. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="-1"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>


    <Border x:Name="CardRoot" Style="{StaticResource DialogCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent">
                <Button Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Left" Margin="12,0,0,0"
                        ToolTip="{x:Static res:Strings.CommonCloseTooltip}"
                        Click="CloseButton_Click" />
                <TextBlock Text="{x:Static res:Strings.TrimTitle}" Style="{StaticResource TitleText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource ViewportCard}" Margin="18,0,18,0">
                <Grid>
                    <MediaElement x:Name="MediaPreview" LoadedBehavior="Manual" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  MediaOpened="MediaPreview_MediaOpened" />
                    <Image x:Name="FallbackImage" Stretch="Uniform" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Timeline + transport -->
            <StackPanel Grid.Row="2" Margin="18,14,18,16">
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="{x:Static res:Strings.TrimHint}" Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Left" />
                    <TextBlock x:Name="SelectedDurationText" Style="{StaticResource MonoText}"
                               HorizontalAlignment="Right" />
                </Grid>

                <Border Height="52" CornerRadius="8" ClipToBounds="True"
                        Background="{DynamicResource ViewportBrush}">
                    <Grid x:Name="TimelineGrid" SizeChanged="TimelineGrid_SizeChanged">
                        <!-- Real frames sampled across the video land here once
                             ffmpeg has produced them; until then the placeholder
                             blocks below stand in. -->
                        <UniformGrid x:Name="FilmstripPlaceholder" Rows="1" Columns="8" Opacity="0.55">
                            <Border Background="{DynamicResource ViewportAltBrush}" Margin="1,0" />
                            <Border Background="#332F35" Margin="1,0" />
                            <Border Background="{DynamicResource ViewportAltBrush}" Margin="1,0" />
                            <Border Background="#332F35" Margin="1,0" />
                            <Border Background="{DynamicResource ViewportAltBrush}" Margin="1,0" />
                            <Border Background="#332F35" Margin="1,0" />
                            <Border Background="{DynamicResource ViewportAltBrush}" Margin="1,0" />
                            <Border Background="#332F35" Margin="1,0" />
                        </UniformGrid>

                        <UniformGrid x:Name="FilmstripFrames" Rows="1" Visibility="Collapsed" />

                        <Canvas x:Name="TimelineCanvas">
                            <Border x:Name="TrimRangeBorder" Height="52" Background="#3DEB5E14"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,2">
                                <Grid>
                                    <Border Width="12" Background="{DynamicResource AccentBrush}"
                                            CornerRadius="3,0,0,3"
                                            HorizontalAlignment="Left" Cursor="SizeWE"
                                            MouseLeftButtonDown="LeftHandle_MouseDown"
                                            MouseMove="LeftHandle_MouseMove"
                                            MouseLeftButtonUp="Handle_MouseUp">
                                        <Rectangle Width="2" Height="16" RadiusX="1" RadiusY="1" Fill="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Width="12" Background="{DynamicResource AccentBrush}"
                                            CornerRadius="0,3,3,0"
                                            HorizontalAlignment="Right" Cursor="SizeWE"
                                            MouseLeftButtonDown="RightHandle_MouseDown"
                                            MouseMove="RightHandle_MouseMove"
                                            MouseLeftButtonUp="Handle_MouseUp">
                                        <Rectangle Width="2" Height="16" RadiusX="1" RadiusY="1" Fill="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Canvas>
                    </Grid>
                </Border>

                <Grid Margin="0,8,0,0">
                    <TextBlock x:Name="StartTimeText" Style="{StaticResource MonoText}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="EndTimeText" Style="{StaticResource MonoText}" HorizontalAlignment="Right" />
                </Grid>

                <Grid Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource IconButton}" Content="&#x23EE;" Margin="0,0,6,0"
                                Click="StepBack_Click" ToolTip="{x:Static res:Strings.TrimStepBackTooltip}" />
                        <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}"
                                Content="&#x25B6;" Width="34" Height="34" FontSize="13" Margin="0,0,6,0"
                                Click="PlayPause_Click" ToolTip="{x:Static res:Strings.TrimPlayPauseTooltip}" />
                        <Button Style="{StaticResource IconButton}" Content="&#x23ED;"
                                Click="StepForward_Click" ToolTip="{x:Static res:Strings.TrimStepForwardTooltip}" />
                    </StackPanel>

                    <TextBlock x:Name="CurrentPositionText" Style="{StaticResource MonoText}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <TextBlock x:Name="OutputPreviewText" Style="{StaticResource CaptionText}"
                           Margin="0,12,0,0" Visibility="Collapsed" />
            </StackPanel>

            <Border Grid.Row="3" Style="{StaticResource DialogFooterBar}" Padding="20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static res:Strings.CommonCancelButton}" Margin="0,0,10,0"
                            Click="CloseButton_Click" />
                    <Button Content="{x:Static res:Strings.CommonApplyButton}" IsDefault="True"
                            Click="ApplyButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
