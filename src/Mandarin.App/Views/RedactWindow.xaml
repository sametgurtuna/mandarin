<Window x:Class="Mandarin.App.Views.RedactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Mandarin.App.Resources"
        Title="{x:Static res:Strings.RedactTitle}"
        Width="496" Height="656"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        ShowInTaskbar="False">
    <!-- No OS title bar, but a real (non-layered) window: the DWM acrylic
         backdrop needs a glass frame extended over the whole client area, which
         a per-pixel-alpha window cannot have. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="-1"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>


    <Border x:Name="CardRoot" Style="{StaticResource DialogCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent">
                <Button Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Left" Margin="12,0,0,0"
                        ToolTip="{x:Static res:Strings.CommonCloseTooltip}"
                        Click="CloseButton_Click" />
                <TextBlock x:Name="TitleText" Text="{x:Static res:Strings.RedactTitle}"
                           Style="{StaticResource TitleText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource ViewportCard}" Margin="18,0,18,0">
                <Grid x:Name="ViewportGrid" SizeChanged="ViewportGrid_SizeChanged">
                    <Image x:Name="PreviewImage" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <Canvas x:Name="SelectionCanvas" Background="#01000000" Cursor="Cross"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                            MouseMove="Canvas_MouseMove"
                            MouseLeftButtonUp="Canvas_MouseLeftButtonUp">
                        <!-- Redaction rectangles are added here as they are drawn. -->
                    </Canvas>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="18,14,18,16">
                <TextBlock Text="{x:Static res:Strings.RedactHint}" Style="{StaticResource CaptionText}"
                           Margin="0,0,0,12" />

                <!-- One label column, one control column: the three settings rows
                     line up instead of each finding its own alignment. -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.RedactStyleLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton x:Name="SolidStyleRadio" Content="{x:Static res:Strings.RedactStyleSolid}"
                                     IsChecked="True" GroupName="StyleGroup" Checked="Style_Checked"
                                     Margin="0,0,14,0" VerticalAlignment="Center" />
                        <RadioButton x:Name="BlurStyleRadio" Content="{x:Static res:Strings.RedactStyleBlur}"
                                     GroupName="StyleGroup" Checked="Style_Checked"
                                     Margin="0,0,14,0" VerticalAlignment="Center" />
                        <RadioButton x:Name="PixelateStyleRadio" Content="{x:Static res:Strings.RedactStylePixelate}"
                                     GroupName="StyleGroup" Checked="Style_Checked" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.RedactColorLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Width="40" Height="20" Background="#000000" CornerRadius="10"
                            HorizontalAlignment="Right"
                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.RedactDetectLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{x:Static res:Strings.RedactDetectFaces}" Margin="0,0,8,0"
                                Click="DetectFaces_Click" />
                        <Button Content="{x:Static res:Strings.RedactDetectText}" Click="DetectText_Click" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="OutputPreviewText" Style="{StaticResource CaptionText}"
                           Margin="0,12,0,0" Visibility="Collapsed" />
            </StackPanel>

            <Border Grid.Row="3" Style="{StaticResource DialogFooterBar}" Padding="20,14">
                <Grid>
                    <Button Content="{x:Static res:Strings.CommonResetButton}"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left" Click="ResetButton_Click" />
                    <Button Content="{x:Static res:Strings.RedactSaveButton}"
                            HorizontalAlignment="Right" IsDefault="True"
                            Click="SaveButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
