<Window x:Class="Mandarin.App.Views.FfmpegSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Mandarin.App.Resources"
        Title="{x:Static res:Strings.FfmpegTitle}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="-1"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="CardRoot" Style="{StaticResource DialogCard}">
        <StackPanel>
            <Grid x:Name="HeaderBar" Height="46" Background="Transparent">
                <Button Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Left" Margin="12,0,0,0"
                        ToolTip="{x:Static res:Strings.CommonCloseTooltip}"
                        Click="CancelButton_Click" />
                <TextBlock Text="{x:Static res:Strings.FfmpegTitle}" Style="{StaticResource TitleText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Margin="20,0,20,20">
                <TextBlock Text="{x:Static res:Strings.FfmpegExplanation}"
                           Style="{StaticResource SubtitleText}" Margin="0,0,0,14" />

                <!-- Where Mandarin looks by itself, so the user can just drop the
                     binary in place instead of picking it every time. -->
                <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="8" Padding="12,10"
                        BorderBrush="{DynamicResource BorderBrushToken}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.FfmpegSearchedLabel}"
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                        <TextBlock x:Name="SearchedPathsText" Style="{StaticResource MonoText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,8,0,0" />
            </StackPanel>

            <Border Style="{StaticResource DialogFooterBar}" Padding="20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static res:Strings.CommonCancelButton}" Margin="0,0,10,0"
                            Click="CancelButton_Click" />
                    <Button Content="{x:Static res:Strings.FfmpegLocateButton}" IsDefault="True"
                            Click="LocateButton_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
