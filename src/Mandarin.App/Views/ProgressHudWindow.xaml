<Window x:Class="Mandarin.App.Views.ProgressHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mandarin Progress"
        Width="350" Height="66"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <!-- No OS title bar, but a real (non-layered) window: the DWM acrylic
         backdrop needs a glass frame extended over the whole client area, which
         a per-pixel-alpha window cannot have. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="-1"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>


    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="HudCard" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HudCard"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="10.0" To="0.0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="HudCard" Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="HudCard"
            Background="{DynamicResource AcrylicTintBrush}"
            CornerRadius="0"
            BorderThickness="0"
            Cursor="Hand"
            MouseLeftButtonUp="HudCard_MouseLeftButtonUp">
        <Border.RenderTransform>
            <TranslateTransform X="0" Y="0" />
        </Border.RenderTransform>

        <Grid Margin="12,10,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Row: Cancel button + Title -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Cancel Button -->
                <Button x:Name="CancelButton" Grid.Column="0"
                        Width="22" Height="22"
                        Cursor="Hand"
                        Click="CancelButton_Click"
                        ToolTip="Cancel">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="11">
                                <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Action Title -->
                <TextBlock x:Name="TitleText" Grid.Column="1"
                           Text=""
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- Subtitle: Source file name or progress detail -->
            <TextBlock x:Name="SubtitleText" Grid.Row="1"
                       Text=""
                       FontFamily="{StaticResource UiFontFamily}"
                       FontSize="11.5" FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="30,1,0,5"
                       TextTrimming="CharacterEllipsis" />

            <!-- Progress Bar -->
            <Grid Grid.Row="2" Margin="30,0,0,0" Height="4.5" x:Name="ProgressBarContainer">
                <!-- Track -->
                <Border Background="{DynamicResource SurfacePressedBrush}" CornerRadius="2.25" />

                <!-- Progress Fill -->
                <Border x:Name="ProgressBarFill" HorizontalAlignment="Left" Width="0" CornerRadius="2.25">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource AccentColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
