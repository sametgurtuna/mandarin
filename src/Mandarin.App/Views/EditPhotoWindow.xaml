<Window x:Class="Mandarin.App.Views.EditPhotoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Mandarin.App.Resources"
        Title="{x:Static res:Strings.EditPhotoTitle}"
        Width="496" Height="696"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        ShowInTaskbar="False">
    <!-- No OS title bar, but a real (non-layered) window: the DWM acrylic
         backdrop needs a glass frame extended over the whole client area, which
         a per-pixel-alpha window cannot have. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="-1"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>


    <Window.Resources>
        <!-- One adjustment row = label | slider | value | revert. These three
             styles keep every row on the same grid without repeating metrics. -->
        <Style x:Key="AdjLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="AdjValue" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="AdjReset" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Content" Value="&#x21BA;" />
            <Setter Property="ToolTip" Value="{x:Static res:Strings.EditPhotoResetTooltip}" />
        </Style>
    </Window.Resources>

    <Border x:Name="CardRoot" Style="{StaticResource DialogCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="260" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent">
                <Button Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Left" Margin="12,0,0,0"
                        ToolTip="{x:Static res:Strings.CommonCloseTooltip}"
                        Click="CloseButton_Click" />
                <TextBlock Text="{x:Static res:Strings.EditPhotoTitle}" Style="{StaticResource TitleText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource ViewportCard}" Margin="18,0,18,0">
                <Image x:Name="PreviewImage" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <TextBlock x:Name="OutputPreviewText" Grid.Row="3" Style="{StaticResource CaptionText}"
                       Margin="18,10,18,0" Visibility="Collapsed" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="18,14,10,0" Padding="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.EditPhotoGroupLight}" Style="{StaticResource SectionHeaderText}" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.EditPhotoExposure}" Style="{StaticResource AdjLabel}" />
                        <Slider x:Name="ExposureSlider" Grid.Column="1" Minimum="-2.0" Maximum="2.0" Value="0.0"
                                SmallChange="0.05" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="ExposureVal" Grid.Column="2" Style="{StaticResource AdjValue}" />
                        <Button Grid.Column="3" Style="{StaticResource AdjReset}" Click="ResetExposure_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.EditPhotoBrightness}" Style="{StaticResource AdjLabel}" />
                        <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="-100" Maximum="100" Value="0"
                                ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="BrightnessVal" Grid.Column="2" Style="{StaticResource AdjValue}" />
                        <Button Grid.Column="3" Style="{StaticResource AdjReset}" Click="ResetBrightness_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.EditPhotoContrast}" Style="{StaticResource AdjLabel}" />
                        <Slider x:Name="ContrastSlider" Grid.Column="1" Minimum="-100" Maximum="100" Value="0"
                                ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="ContrastVal" Grid.Column="2" Style="{StaticResource AdjValue}" />
                        <Button Grid.Column="3" Style="{StaticResource AdjReset}" Click="ResetContrast_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.EditPhotoGamma}" Style="{StaticResource AdjLabel}" />
                        <Slider x:Name="GammaSlider" Grid.Column="1" Minimum="0.2" Maximum="2.5" Value="1.0"
                                SmallChange="0.05" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="GammaVal" Grid.Column="2" Style="{StaticResource AdjValue}" />
                        <Button Grid.Column="3" Style="{StaticResource AdjReset}" Click="ResetGamma_Click" />
                    </Grid>

                    <Separator />

                    <TextBlock Text="{x:Static res:Strings.EditPhotoGroupColor}" Style="{StaticResource SectionHeaderText}" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.EditPhotoSaturation}" Style="{StaticResource AdjLabel}" />
                        <Slider x:Name="SaturationSlider" Grid.Column="1" Minimum="-100" Maximum="100" Value="0"
                                ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="SaturationVal" Grid.Column="2" Style="{StaticResource AdjValue}" />
                        <Button Grid.Column="3" Style="{StaticResource AdjReset}" Click="ResetSaturation_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.EditPhotoHue}" Style="{StaticResource AdjLabel}" />
                        <Slider x:Name="HueSlider" Grid.Column="1" Minimum="-100" Maximum="100" Value="0"
                                ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="HueVal" Grid.Column="2" Style="{StaticResource AdjValue}" />
                        <Button Grid.Column="3" Style="{StaticResource AdjReset}" Click="ResetHue_Click" />
                    </Grid>

                    <Separator />

                    <TextBlock Text="{x:Static res:Strings.EditPhotoGroupDetail}" Style="{StaticResource SectionHeaderText}" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.EditPhotoClarity}" Style="{StaticResource AdjLabel}" />
                        <Slider x:Name="ClaritySlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                                ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="ClarityVal" Grid.Column="2" Style="{StaticResource AdjValue}" />
                        <Button Grid.Column="3" Style="{StaticResource AdjReset}" Click="ResetClarity_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.EditPhotoNoiseReduction}" Style="{StaticResource AdjLabel}"
                                   ToolTip="{x:Static res:Strings.EditPhotoNoiseReduction}" />
                        <Slider x:Name="NoiseSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                                ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="NoiseVal" Grid.Column="2" Style="{StaticResource AdjValue}" />
                        <Button Grid.Column="3" Style="{StaticResource AdjReset}" Click="ResetNoise_Click" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="4" Style="{StaticResource DialogFooterBar}" Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static res:Strings.CommonCancelButton}" Margin="0,0,10,0"
                            Click="CloseButton_Click" />
                    <Button Content="{x:Static res:Strings.EditPhotoSaveButton}" IsDefault="True"
                            Click="SaveButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
