<Window x:Class="Mandarin.App.Views.RadialWheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Mandarin.App.Views"
        Title="Mandarin Wheel"
        Width="360" Height="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        FocusVisualStyle="{x:Null}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AllowDrop="True"
        WindowStartupLocation="Manual"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <Window.Resources>
        <Style TargetType="{x:Type Control}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="MenuContainer"
                             Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="MenuScaleTransform"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.88" To="1.0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.2" EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MenuScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.88" To="1.0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.2" EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="RootGrid" Width="360" Height="360" Background="#01000000"
          AllowDrop="True"
          Focusable="False" FocusVisualStyle="{x:Null}">
        <Grid x:Name="MenuContainer" HorizontalAlignment="Center" VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="MenuScaleTransform" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <views:RadialMenuControl x:Name="RadialMenu" />
        </Grid>
    </Grid>
</Window>
