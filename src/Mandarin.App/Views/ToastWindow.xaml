<Window x:Class="Mandarin.App.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mandarin"
        Width="320" SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        MouseEnter="ToastWindow_MouseEnter"
        MouseLeave="ToastWindow_MouseLeave">
    <!-- No OS title bar, but a real (non-layered) window: the DWM acrylic
         backdrop needs a glass frame extended over the whole client area, which
         a per-pixel-alpha window cannot have. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="-1"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>


    <Window.Resources>
        <!-- Slides up as it fades in, so it reads as arriving from the tray corner. -->
        <Storyboard x:Key="ToastEnterStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="14" To="0" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="0" Padding="16,14" BorderThickness="0">
        <Border.RenderTransform>
            <TranslateTransform X="0" Y="0" />
        </Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Success and failure differ by shape as well as colour, so the
                 state doesn't depend on colour vision alone. -->
            <Border x:Name="StatusBadge" Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                    VerticalAlignment="Top" Margin="0,1,11,0">
                <TextBlock x:Name="StatusGlyph" Text="&#x2713;" FontSize="13" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Opacity="0.85" />
                <Button x:Name="OpenFolderButton" Style="{StaticResource OnDarkButton}" Margin="0,11,0,0"
                        HorizontalAlignment="Left" Click="OpenFolderButton_Click"
                        Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
