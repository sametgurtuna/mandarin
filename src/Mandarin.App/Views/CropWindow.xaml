<Window x:Class="Mandarin.App.Views.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Mandarin.App.Resources"
        Title="{x:Static res:Strings.CropTitle}"
        Width="656" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <!-- No OS title bar, but a real (non-layered) window: the DWM acrylic
         backdrop needs a glass frame extended over the whole client area, which
         a per-pixel-alpha window cannot have. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="-1"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="CardRoot" Style="{StaticResource DialogCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent">
                <Button Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Left" Margin="12,0,0,0"
                        ToolTip="{x:Static res:Strings.CommonCloseTooltip}"
                        Click="CancelButton_Click" />
                <TextBlock Text="{x:Static res:Strings.CropTitle}" Style="{StaticResource TitleText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- Aspect ratio on the left, live selection size on the right. -->
            <Grid Grid.Row="1" Margin="18,0,18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="{x:Static res:Strings.CropAspectLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="AspectComboBox" Width="140" SelectionChanged="AspectComboBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Static res:Strings.CropAspectFree}" Tag="free" IsSelected="True" />
                        <ComboBoxItem Content="{x:Static res:Strings.CropAspectOriginal}" Tag="source" />
                        <ComboBoxItem Content="1:1" Tag="1:1" />
                        <ComboBoxItem Content="4:3" Tag="4:3" />
                        <ComboBoxItem Content="3:2" Tag="3:2" />
                        <ComboBoxItem Content="16:9" Tag="16:9" />
                        <ComboBoxItem Content="9:16" Tag="9:16" />
                    </ComboBox>
                </StackPanel>

                <TextBlock x:Name="SizeText" Style="{StaticResource MonoText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource ViewportCard}" Margin="18,0,18,0">
                <Grid x:Name="ViewportGrid" SizeChanged="ViewportGrid_SizeChanged">
                    <Image x:Name="PreviewImage" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <Canvas x:Name="SelectionCanvas" Background="#01000000"
                            Cursor="Cross"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                            MouseMove="Canvas_MouseMove"
                            MouseLeftButtonUp="Canvas_MouseLeftButtonUp">
                        <!-- Shades covering everything outside the selection, so the
                             kept area is the bright one. -->
                        <Rectangle x:Name="ShadeTop" Fill="#8C000000" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Rectangle x:Name="ShadeBottom" Fill="#8C000000" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Rectangle x:Name="ShadeLeft" Fill="#8C000000" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Rectangle x:Name="ShadeRight" Fill="#8C000000" IsHitTestVisible="False" Visibility="Collapsed" />

                        <!-- Rule-of-thirds guides. -->
                        <Line x:Name="GuideV1" Stroke="#59FFFFFF" StrokeThickness="1" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Line x:Name="GuideV2" Stroke="#59FFFFFF" StrokeThickness="1" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Line x:Name="GuideH1" Stroke="#59FFFFFF" StrokeThickness="1" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Line x:Name="GuideH2" Stroke="#59FFFFFF" StrokeThickness="1" IsHitTestVisible="False" Visibility="Collapsed" />

                        <Rectangle x:Name="SelectionRectangle"
                                   Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                   Fill="Transparent" Visibility="Collapsed"
                                   Cursor="SizeAll" />

                        <!-- Handles are added here in code: eight of them, so the
                             set stays in sync with the hit-testing. -->
                    </Canvas>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Margin="18,10,18,0">
                <TextBlock Text="{x:Static res:Strings.CropHint}" Style="{StaticResource CaptionText}" />
                <TextBlock x:Name="OutputPreviewText" Style="{StaticResource CaptionText}"
                           Margin="0,6,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,6,0,0" />
            </StackPanel>

            <Border Grid.Row="4" Style="{StaticResource DialogFooterBar}" Padding="20,14" Margin="0,14,0,0">
                <Grid>
                    <Button Content="{x:Static res:Strings.CommonResetButton}"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left" Click="ResetButton_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{x:Static res:Strings.CommonCancelButton}" Margin="0,0,10,0" Click="CancelButton_Click" />
                        <Button Content="{x:Static res:Strings.CropButton}" Click="OkButton_Click" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
