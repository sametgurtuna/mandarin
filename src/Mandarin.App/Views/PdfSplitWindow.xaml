<Window x:Class="Mandarin.App.Views.PdfSplitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Mandarin.App.Resources"
        Title="{x:Static res:Strings.SplitTitle}"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=FromPageTextBox}">
    <!-- No OS title bar, but a real (non-layered) window: the DWM acrylic
         backdrop needs a glass frame extended over the whole client area, which
         a per-pixel-alpha window cannot have. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="-1"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="CardRoot" Style="{StaticResource DialogCard}">
        <StackPanel>
            <Grid x:Name="HeaderBar" Height="46" Background="Transparent">
                <Button Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Left" Margin="12,0,0,0"
                        ToolTip="{x:Static res:Strings.CommonCloseTooltip}"
                        Click="CancelButton_Click" />
                <TextBlock Text="{x:Static res:Strings.SplitTitle}" Style="{StaticResource TitleText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Margin="20,0,20,20">
                <TextBlock x:Name="PageCountText" Style="{StaticResource SubtitleText}" Margin="0,0,0,18" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static res:Strings.SplitFromPageLabel}" Style="{StaticResource FieldLabelText}" />
                        <TextBox x:Name="FromPageTextBox" Text="1" TextChanged="Input_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Static res:Strings.SplitToPageLabel}" Style="{StaticResource FieldLabelText}" />
                        <TextBox x:Name="ToPageTextBox" TextChanged="Input_TextChanged" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="OutputPreviewText" Style="{StaticResource CaptionText}"
                           Margin="0,12,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,8,0,0" />
            </StackPanel>

            <Border Style="{StaticResource DialogFooterBar}" Padding="20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static res:Strings.CommonCancelButton}" Margin="0,0,10,0" Click="CancelButton_Click" />
                    <Button Content="{x:Static res:Strings.SplitButton}" Click="OkButton_Click" IsDefault="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
