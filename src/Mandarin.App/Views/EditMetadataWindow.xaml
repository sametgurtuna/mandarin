<Window x:Class="Mandarin.App.Views.EditMetadataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Mandarin.App.Resources"
        Title="{x:Static res:Strings.MetadataTitle}"
        Width="496" Height="596"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        ShowInTaskbar="False">
    <!-- No OS title bar, but a real (non-layered) window: the DWM acrylic
         backdrop needs a glass frame extended over the whole client area, which
         a per-pixel-alpha window cannot have. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="-1"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>


    <Border x:Name="CardRoot" Style="{StaticResource DialogCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent">
                <Button Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Left" Margin="12,0,0,0"
                        ToolTip="{x:Static res:Strings.CommonCloseTooltip}"
                        Click="CloseButton_Click" />
                <TextBlock Text="{x:Static res:Strings.MetadataTitle}" Style="{StaticResource TitleText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- Which file we're looking at, and the filter over its tags. -->
            <Grid Grid.Row="1" Margin="20,0,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FileNameText" Grid.Column="0" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="0,0,12,0" />
                <Grid Grid.Column="1" Width="190">
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />
                    <!-- Hand-rolled placeholder: WPF's TextBox has none, and it
                         hides as soon as there is text to show instead. -->
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="{x:Static res:Strings.MetadataSearchPlaceholder}"
                               Style="{StaticResource CaptionText}"
                               Margin="11,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>
            </Grid>

            <Border Grid.Row="2" Margin="20,0,20,0" CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushToken}" BorderThickness="1">
                <Grid>
                    <ScrollViewer Margin="4,6" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TagsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                        <Border Grid.Column="1" Background="{DynamicResource SurfaceSunkenBrush}"
                                                CornerRadius="5" Padding="8,4" Margin="8,0">
                                            <TextBlock Text="{Binding Value}" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Value}" />
                                        </Border>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                Width="24" Height="24" Content="&#x2715;" FontSize="10"
                                                Click="RemoveTagButton_Click" Tag="{Binding}"
                                                ToolTip="{x:Static res:Strings.MetadataRemoveTooltip}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Shown when a file carries no tags, or the filter matches none. -->
                    <TextBlock x:Name="EmptyStateText"
                               Text="{x:Static res:Strings.MetadataEmptyState}"
                               Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Margin="20,12,20,14">
                <TextBlock Text="{x:Static res:Strings.MetadataNotice}" Style="{StaticResource CaptionText}" />
                <TextBlock x:Name="OutputPreviewText" Style="{StaticResource CaptionText}"
                           Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>

            <Border Grid.Row="4" Style="{StaticResource DialogFooterBar}" Padding="20,14">
                <Grid>
                    <Button Content="{x:Static res:Strings.CommonRemoveAllButton}"
                            Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Left" Click="RemoveAllButton_Click" />
                    <Button Content="{x:Static res:Strings.CommonSaveButton}"
                            HorizontalAlignment="Right" IsDefault="True"
                            Click="SaveButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
